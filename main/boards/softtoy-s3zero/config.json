{
    "type": "softtoy-s3zero",
    "target": "esp32s3",
    "builds": [
        {
            "name": "softtoy-s3zero",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/softtoy-s3zero/partitions_8m_factory.csv\"",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_BOOTLOADER_APP_TEST=y",
                "CONFIG_BOOTLOADER_NUM_PIN_APP_TEST=18",
                "CONFIG_BOOTLOADER_APP_TEST_PIN_LOW=y",
                "CONFIG_BOOTLOADER_HOLD_TIME_GPIO=5"
            ]
        }
    ]
}
